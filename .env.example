# Doppler is the primary secret source for this project:
#   project: sre-inference-gateway
#   config:  dev_personal
#
# Use .env only as a non-Doppler fallback for local tinkering. Pass it to a
# host process with `uv run uvicorn --env-file .env ...`; Docker Compose loads
# it automatically. Git ignores .env* except this example. Never commit secrets.

# Real provider adapters
# Used only after the matching provider is enabled in config.yaml.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=
RUNPOD_VLLM_API_KEY=

# Local failover drill
# Exact value 1 enables mock-provider fail/restore routes.
FAILOVER_DRILL_ADMIN=0

# Docker Compose infrastructure
# make dev supplies local defaults; override here when invoking Compose directly.
REDIS_PASSWORD=local-dev-password
GRAFANA_ADMIN_PASSWORD=local-dev-password

# Docker Compose gateway service only
# The app's normal runtime configuration still comes from config.yaml.
DEBUG=false
LOG_LEVEL=INFO

# Production Docker Compose only
GRAFANA_ADMIN_USER=admin

# vLLM Compose service only
# make dev does not start this service.
VLLM_MODEL=google/gemma-3-270m
VLLM_PORT=8080
VLLM_HOST=0.0.0.0
VLLM_MAX_MODEL_LEN=1024
VLLM_GPU_MEMORY_UTILIZATION=0.7
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_TRUST_REMOTE_CODE=false
VLLM_ENABLE_GPU=false
HUGGING_FACE_HUB_TOKEN=

# Grafana Cloud is Doppler-only; do not place these values in .env:
# GRAFANA_CLOUD_PROMETHEUS_URL
# GRAFANA_CLOUD_PROMETHEUS_USERNAME
# GRAFANA_CLOUD_PROMETHEUS_TOKEN
