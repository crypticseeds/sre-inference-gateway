  {
   "name": "Chat (mock, no keys)",
   "item": [
    {
     "name": "Mock non-streaming",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "X-Provider-Priority",
        "value": "mock_openai"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"model\": \"mock-model\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"Say hello briefly.\"}],\n  \"stream\": false\n}"
      },
      "url": "{{base_url}}/v1/chat/completions"
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Status is 200', () => pm.response.to.have.status(200));"
        ]
       }
      }
     ],
     "response": []
    },
    {
     "name": "Mock streaming",
     "request": {
      "description": "Postman renders the text/event-stream response progressively.",
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "X-Provider-Priority",
        "value": "mock_openai"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"model\": \"mock-model\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"Stream a short greeting.\"}],\n  \"stream\": true\n}"
      },
      "url": "{{base_url}}/v1/chat/completions"
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Status is 200', () => pm.response.to.have.status(200));"
        ]
       }
      }
     ],
     "response": []
    },
    {
     "name": "Mock streaming with usage",
     "request": {
      "description": "Postman renders the text/event-stream response progressively. The final SSE payload includes usage.",
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "X-Provider-Priority",
        "value": "mock_openai"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"model\": \"mock-model\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"Stream a short greeting with usage.\"}],\n  \"stream\": true,\n  \"stream_options\": {\"include_usage\": true}\n}"
      },
      "url": "{{base_url}}/v1/chat/completions"
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Status is 200', () => pm.response.to.have.status(200));",
         "pm.test('SSE body contains usage', () => pm.expect(pm.response.text()).to.include('usage'));"
        ]
       }
      }
     ],
     "response": []
    }
   ]
  },
  {
   "name": "Chat (real providers, pinned)",
   "description": "Enable only the provider under test in config.yaml, restart the gateway, run its requests, then revert config.yaml.",
   "item": [
    {
     "name": "OpenRouter non-streaming",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "X-Provider-Priority",
        "value": "openrouter"
       },
       {
        "key": "X-No-Failover",
        "value": "1"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"model\": \"{{openrouter_model}}\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"Reply with one short sentence.\"}],\n  \"stream\": false\n}"
      },
      "url": "{{base_url}}/v1/chat/completions"
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Status is 200', () => pm.response.to.have.status(200));",
         "pm.test('Served by OpenRouter', () => pm.expect(pm.response.headers.get('X-Served-By')).to.eql('openrouter'));",
         "pm.test('Response is not a mock fallback', () => pm.expect(pm.response.text()).not.to.include('Mock OpenAI response')); "
        ]
       }
      }
     ],
     "response": []
