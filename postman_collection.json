{
 "info": {
  "_postman_id": "sre-inference-gateway-collection",
  "name": "SRE Inference Gateway",
  "description": "Independent gateway checks for mock and pinned real providers. Real-provider requests require the matching disabled provider to be enabled temporarily in config.yaml.",
